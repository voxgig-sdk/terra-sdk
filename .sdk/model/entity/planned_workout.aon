      req: false
      short: "Terra identifier of the planned workout"
      type: "`$STRING`"
    }
    {
      name: "provider_workout_id"
      req: false
      short: "Identifier assigned by the provider, once pushed."
      type: "`$STRING`"
    }
    {
      name: "workout_id"
      req: false
      short: "Identifier of the source template."
      type: "`$STRING`"
    }
  ]

