          contract: {
            id: "GET /plannedWorkouts"
            json: "{\"operationId\":\"Workouts_ListPlannedWorkouts\",\"parameters\":[{\"in\":\"query\",\"name\":\"user_id\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"Start of the planned-date window (YYYY-MM-DD). When start_date and end_date are omitted, provider-side workouts default to the trailing 30 days; pass an explicit window to list upcoming workouts.\\n\",\"in\":\"query\",\"name\":\"start_date\",\"required\":false,\"schema\":{\"format\":\"date\",\"type\":\"string\"}},{\"description\":\"End of the planned-date window (YYYY-MM-DD), inclusive.\",\"in\":\"query\",\"name\":\"end_date\",\"required\":false,\"schema\":{\"format\":\"date\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"A workout template scheduled onto a user's calendar\",\"properties\":{\"athlete_metrics\":{\"anyOf\":[{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"Athlete-specific metrics used to personalise workout targets for one planned workout\",\"properties\":{\"ftp\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Functional Threshold Power in watts\"},\"max_heart_rate\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Maximum heart rate in BPM\"},\"pool_length_meters\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Pool length in meters (overrides the template value)\"},\"threshold_heart_rate\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Threshold heart rate in BPM\"},\"threshold_speed\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Threshold speed in m/s\"}},\"type\":\"object\"},{\"type\":\"null\"}]},\"coercion_warnings\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Warnings emitted when the template could not be represented exactly on the provider\"},\"created_at\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Creation time (RFC 3339)\"},\"details\":{\"anyOf\":[{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"Full body of a provider-side planned workout, fetched live from the provider. Present only on external planned workouts (is_external true), which have no Terra workout template.\",\"properties\":{\"metadata\":{\"anyOf\":[{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"Summary metadata of a provider-side planned workout\",\"properties\":{\"created_date\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Creation time on the provider's side (RFC 3339)\"},\"description\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Workout description, when the provider exposes one\"},\"estimated_calories\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"estimated_distance_meters\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"estimated_duration_seconds\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"estimated_elevation_gain_meters\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"estimated_energy_kj\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"estimated_if\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Planned Intensity Factor\"},\"estimated_speed_meters_per_second\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"estimated_tss\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Planned Training Stress Score\"},\"id\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Identifier of the workout on the provider's side\"},\"name\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Workout title\"},\"planned_date\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Scheduled date (YYYY-MM-DD), matching the list item's planned_date\"},\"pool_length_meters\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"provider\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Provider the workout was fetched from\"},\"type\":{\"anyOf\":[{\"maximum\":2147483647,\"minimum\":-2147483648,\"type\":\"integer\"},{\"type\":\"null\"}],\"description\":\"Numeric activity type of the workout\"}},\"type\":\"object\"},{\"type\":\"null\"}]},\"steps\":{\"anyOf\":[{\"items\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"A step of a provider-side planned workout\",\"properties\":{\"description\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"durations\":{\"anyOf\":[{\"items\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"Completion condition of a provider planned-workout step\",\"properties\":{\"calories\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"distance_meters\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"duration_type\":{\"maximum\":2147483647,\"minimum\":-2147483648,\"type\":\"integer\"},\"hr_above_bpm\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"hr_below_bpm\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"power_above_watts\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"power_below_watts\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"reps\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"rest_seconds\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"seconds\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"steps\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]}},\"required\":[\"duration_type\"],\"type\":\"object\"},\"type\":\"array\"},{\"type\":\"null\"}]},\"equipment_type\":{\"anyOf\":[{\"items\":{\"maximum\":2147483647,\"minimum\":-2147483648,\"type\":\"integer\"},\"type\":\"array\"},{\"type\":\"null\"}]},\"exercise_category\":{\"