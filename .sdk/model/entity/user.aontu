# Entity: user

main: kit: entity: user: {

  alias: field: {}

  fields: {
    max_page: {
      h: "Max Page"
      n: "max_page"
      r: false
      sh: "Total number of pages available for the requested page size"
      t: "`$INTEGER`"
    }
    next: {
      h: "Next"
      n: "next"
      r: false
      sh: "The next page number, or null if there is no next page"
      t: [
        "`$ONE`"
        [
          "`$INTEGER`"
          "`$NULL`"
        ]
      ]
    }
    results: {
      h: "Results"
      n: "results"
      r: false
      t: "`$ARRAY`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      t: "`$STRING`"
    }
    users: {
      h: "Users"
      n: "users"
      r: false
      t: "`$ARRAY`"
    }
  }

  name: "user"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /subscriptions"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 0
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 500
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/subscriptions"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "subscriptions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /userInfo"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "reference_id"
                or: "reference_id"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "user_id"
                or: "user_id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/userInfo"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "userInfo"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
