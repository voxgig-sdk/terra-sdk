# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: [
    {
      name: "auth_failure_redirect_url"
      req: false
      short: "URL the user is redirected to upon unsuccessful authentication"
      type: "`$STRING`"
    }
    {
      name: "auth_success_redirect_url"
      req: false
      short: "URL the user is redirected to upon successful authentication"
      type: "`$STRING`"
    }
    {
      name: "auth_url"
      req: false
      short: "authentication URL the user must be redirected to in order to link their account"
      type: "`$STRING`"
    }
    {
      name: "expires_in"
      req: false
      short: "a number in seconds depicting how long the url is valid for"
      type: "`$INTEGER`"
    }
    {
      name: "language"
      req: false
      short: "Display language of the widget"
      type: "`$STRING`"
    }
    {
      name: "providers"
      req: false
      short: "Comma separated list of providers to display on the device selection page."
      type: "`$STRING`"
    }
    {
      name: "reference_id"
      req: false
      short: "Identifier of the end user on your system, such as a user ID or email associated with them"
      type: "`$STRING`"
    }
    {
      name: "session_id"
      req: false
      short: "Session ID for the widget authentication session"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "indicates that the request was successful"
      type: "`$STRING`"
    }
    {
      name: "token"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "the widget URL the user must be redirected to in order to link their account"
      type: "`$STRING`"
    }
    {
      name: "user_id"
      req: false
      short: "User ID for the user being created"
      type: "`$STRING`"
    }
  ]

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                example: "testingTerra"
                kind: "header"
                name: "dev_id"
                orig: "dev_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "FITBIT"
                kind: "query"
                name: "resource"
                orig: "resource"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/auth/authenticateUser"
          parts: [
            "auth"
            "authenticateUser"
          ]
          select: {
            exist: [
              "dev_id"
              "resource"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/auth/generateAuthToken"
          parts: [
            "auth"
            "generateAuthToken"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/auth/generateWidgetSession"
          parts: [
            "auth"
            "generateWidgetSession"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "user_id"
                orig: "user_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/auth/deauthenticateUser"
          parts: [
            "auth"
            "deauthenticateUser"
          ]
          select: {
            exist: [
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
