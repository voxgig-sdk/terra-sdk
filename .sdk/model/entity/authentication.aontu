# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: {
    auth_failure_redirect_url: {
      h: "Auth Failure Redirect Url"
      n: "auth_failure_redirect_url"
      r: false
      t: "`$STRING`"
    }
    auth_success_redirect_url: {
      h: "Auth Success Redirect Url"
      n: "auth_success_redirect_url"
      r: false
      t: "`$STRING`"
    }
    auth_url: {
      h: "Auth Url"
      n: "auth_url"
      r: false
      sh: "authentication URL the user must be redirected to in order to link their account"
      t: "`$STRING`"
    }
    expires_in: {
      h: "Expires In"
      n: "expires_in"
      r: false
      t: "`$INTEGER`"
    }
    language: {
      h: "Language"
      n: "language"
      r: false
      t: "`$STRING`"
    }
    reference_id: {
      h: "Reference Id"
      n: "reference_id"
      r: false
      t: "`$STRING`"
    }
    sdk_app: {
      h: "Sdk App"
      n: "sdk_app"
      r: false
      sh: "Which Terra reference app an SDK authentication link hands the end user to."
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "indicates that the request was successful"
      t: "`$STRING`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      t: "`$STRING`"
    }
    user_id: {
      h: "User Id"
      n: "user_id"
      r: false
      sh: "User ID for the user being created"
      t: "`$STRING`"
    }
  }

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "auth_failure_redirect_url"
            "auth_success_redirect_url"
            "language"
            "reference_id"
            "sdk_app"
          ]
          co: {
            id: "POST /auth/authenticateUser"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                ex: "testingTerra"
                k: "header"
                n: "dev_id"
                or: "dev-id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "FITBIT"
                k: "query"
                n: "resource"
                or: "resource"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/auth/authenticateUser"
          q: {
            exist: [
              "dev_id"
              "resource"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "auth"
            }
            {
              lit: "authenticateUser"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /auth/generateAuthToken"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "user-42"
                k: "query"
                n: "reference_id"
                or: "reference_id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/auth/generateAuthToken"
          q: {
            "$action": "generate_auth_token"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "auth"
            }
            {
              lit: "generateAuthToken"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "apple_app_url"
            "auth_failure_redirect_url"
            "auth_success_redirect_url"
            "bypass_feedback"
            "connected_uids"
            "language"
            "multi_auth"
            "providers"
            "reference_id"
            "samsung_app_url"
            "show_disconnect"
            "use_terra_avengers_app"
          ]
          co: {
            id: "POST /auth/generateWidgetSession"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/auth/generateWidgetSession"
          q: {
            "$action": "widget_session"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "auth"
            }
            {
              lit: "generateWidgetSession"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /auth/tokens"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "user-42"
                k: "query"
                n: "reference_id"
                or: "reference_id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/auth/tokens"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "auth"
            }
            {
              lit: "tokens"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /auth/deauthenticateUser"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "user_id"
                or: "user_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/auth/deauthenticateUser"
          q: {
            exist: [
              "user_id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "auth"
            }
            {
              lit: "deauthenticateUser"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
