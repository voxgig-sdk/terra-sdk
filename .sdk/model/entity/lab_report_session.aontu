# Entity: lab_report_session

main: kit: entity: lab_report_session: {

  alias: field: {}

  fields: {
    collection_date: {
      h: "Collection Date"
      n: "collection_date"
      r: false
      sh: "Date the sample was collected or the scan was taken (YYYY-MM-DD); omitted if not extracted."
      t: "`$STRING`"
    }
    collection_time: {
      h: "Collection Time"
      n: "collection_time"
      r: false
      sh: "Time the sample was collected or the scan was taken (HH:MM, 24-hour); omitted if not extracted."
      t: "`$STRING`"
    }
    current_status: {
      h: "Current Status"
      n: "current_status"
      r: true
      sh: "Current status as a clean lowercase string (open enum — handle unknown values gracefully)."
      t: "`$STRING`"
    }
    error: {
      h: "Error"
      n: "error"
      r: true
      sh: "Why the report failed: the same object the lab_report.failed webhook carries."
      t: "`$OBJECT`"
    }
    file_count: {
      h: "File Count"
      n: "file_count"
      r: false
      t: "`$INTEGER`"
    }
    input_bytes: {
      h: "Input Bytes"
      n: "input_bytes"
      r: false
      t: "`$INTEGER`"
    }
    lab_name: {
      h: "Lab Name"
      n: "lab_name"
      r: false
      t: "`$STRING`"
    }
    output_bytes: {
      h: "Output Bytes"
      n: "output_bytes"
      r: false
      t: "`$INTEGER`"
    }
    panels: {
      h: "Panels"
      n: "panels"
      r: false
      sh: "Report-level panels that results reference by panel_id."
      t: "`$ARRAY`"
    }
    patient_age_at_collection: {
      h: "Patient Age At Collection"
      n: "patient_age_at_collection"
      r: false
      sh: "Patient age in years; omitted if unknown."
      t: "`$INTEGER`"
    }
    patient_sex: {
      h: "Patient Sex"
      n: "patient_sex"
      r: false
      sh: "Clean lowercase string (open enum); omitted if unspecified."
      t: "`$STRING`"
    }
    reference_id: {
      h: "Reference Id"
      n: "reference_id"
      r: false
      sh: "Your external reference; omitted if not set."
      t: "`$STRING`"
    }
    report_date: {
      h: "Report Date"
      n: "report_date"
      r: false
      sh: "Date printed on the report (YYYY-MM-DD); omitted if not extracted."
      t: "`$STRING`"
    }
    report_locale: {
      h: "Report Locale"
      n: "report_locale"
      r: false
      t: "`$STRING`"
    }
    report_notes: {
      h: "Report Notes"
      n: "report_notes"
      r: false
      t: "`$STRING`"
    }
    report_time: {
      h: "Report Time"
      n: "report_time"
      r: false
      sh: "Time printed on the report (HH:MM, 24-hour); omitted if not extracted."
      t: "`$STRING`"
    }
    report_type: {
      h: "Report Type"
      n: "report_type"
      r: true
      sh: "What kind of report this is, as a clean lowercase string (open enum — handle unknown values gracefully)."
      t: "`$STRING`"
    }
    results: {
      h: "Results"
      n: "results"
      r: false
      sh: "The layered biomarker results."
      t: "`$ARRAY`"
    }
    results_count: {
      h: "Results Count"
      n: "results_count"
      r: false
      t: "`$INTEGER`"
    }
    session_id: {
      h: "Session Id"
      n: "session_id"
      r: true
      t: "`$STRING`"
    }
    status_history: {
      h: "Status History"
      n: "status_history"
      r: false
      t: "`$ARRAY`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      t: "`$STRING`"
    }
    upload_id: {
      h: "Upload Id"
      n: "upload_id"
      r: false
      t: "`$STRING`"
    }
    uploaded_at: {
      fo: "date-time"
      h: "Uploaded At"
      n: "uploaded_at"
      r: false
      t: "`$STRING`"
    }
  }

  name: "lab_report_session"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /reports/{session_id}/reprocess"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "x_terra_version"
                or: "X-Terra-Version"
                r: false
                t: "`$STRING`"
              }
            ]
            params: [
              {
                ex: "297405620317847552"
                k: "param"
                n: "session_id"
                or: "session_id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "legacy_format"
                or: "legacy_format"
                r: false
                t: "`$BOOLEAN`"
              }
            ]
          }
          m: "POST"
          o: "/reports/{session_id}/reprocess"
          q: {
            "$action": "reprocess"
            exist: [
              "session_id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "reports"
            }
            {
              var: "session_id"
            }
            {
              lit: "reprocess"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /reports/{session_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "x_terra_version"
                or: "X-Terra-Version"
                r: false
                t: "`$STRING`"
              }
            ]
            params: [
              {
                ex: "297405620317847552"
                k: "param"
                n: "session_id"
                or: "session_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/reports/{session_id}"
          q: {
            exist: [
              "session_id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "reports"
            }
            {
              var: "session_id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
