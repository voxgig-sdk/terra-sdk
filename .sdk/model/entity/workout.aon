# Entity: workout

main: kit: entity: workout: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Description of the workout"
      type: "`$STRING`"
    }
    {
      name: "environment"
      req: false
      type: "`$ANY`"
      union: {
        branches: 3
        count: 1
        depth: 2
      }
    }
    {
      name: "estimated_calories"
      req: false
      short: "Estimated calories burned"
      type: "`$ANY`"
    }
    {
      name: "estimated_distance_meters"
      req: false
      short: "Estimated total distance in meters"
      type: "`$ANY`"
    }
    {
      name: "estimated_duration_seconds"
      req: false
      short: "Estimated total duration in seconds"
      type: "`$ANY`"
    }
    {
      name: "ftp"
      req: false
      short: "Functional Threshold Power in watts"
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "max_heart_rate"
      req: false
      short: "Maximum heart rate in BPM"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: true
      short: "Name of the workout"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "planned_date"
      req: true
      short: "Date to schedule the workout on (YYYY-MM-DD)"
      type: "`$STRING`"
    }
    {
      name: "pool_length_meters"
      req: false
      short: "Pool length in meters, for swim workouts"
      type: "`$ANY`"
    }
    {
      name: "sport"
      req: true
      short: "Sport a workout template targets."
      type: "`$ANY`"
      union: {
        branches: 15
        count: 1
        depth: 0
      }
    }
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
    {
      name: "step_blocks"
      req: true
      type: "`$ARRAY`"
      union: {
        branches: 11
        count: 8
        depth: 13
      }
    }
    {
      name: "threshold_heart_rate"
      req: false
      short: "Threshold heart rate in BPM"
      type: "`$NUMBER`"
    }
    {
      name: "threshold_speed"
      req: false
      short: "Threshold speed in m/s"
      type: "`$NUMBER`"
    }
    {
      name: "workout_id"
      req: false
      short: "Terra identifier of the stored template."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "workout"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "workout_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "user_id"
                orig: "user_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/workouts/{workout_id}/plan"
          rename: {
            param: {
              workout_id: "id"
            }
          }
          segments: [
            {
              lit: "workouts"
            }
            {
              var: "id"
            }
            {
              lit: "plan"
            }
          ]
          select: {
            "$action": "plan"
            exist: [
              "id"
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/workouts"
          segments: [
            {
              lit: "workouts"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/workouts"
          segments: [
            {
              lit: "workouts"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "workout_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/workouts/{workout_id}"
          rename: {
            param: {
              workout_id: "id"
            }
          }
          segments: [
            {
              lit: "workouts"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "planned_workout_id"
                orig: "planned_workout_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "user_id"
                orig: "user_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/plannedWorkouts/{planned_workout_id}"
          segments: [
            {
              lit: "plannedWorkouts"
            }
            {
              var: "planned_workout_id"
            }
          ]
          select: {
            exist: [
              "planned_workout_id"
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "workout_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "DELETE"
          orig: "/workouts/{workout_id}"
          rename: {
            param: {
              workout_id: "id"
            }
          }
          segments: [
            {
              lit: "workouts"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "planned_workout"
      ]
    ]
  }



}
