# Entity: workout

main: kit: entity: workout: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Description of the workout"
      type: "`$STRING`"
    }
    {
      name: "environment"
      req: false
      type: "`$ANY`"
      union: {
        branches: 3
        count: 1
        depth: 2
      }
    }
    {
      name: "estimated_calories"
      req: false
      short: "Estimated calories burned"
      type: "`$ANY`"
    }
    {
      name: "estimated_distance_meters"
      req: false
      short: "Estimated total distance in meters"
      type: "`$ANY`"
    }
    {
      name: "estimated_duration_seconds"
      req: false
      short: "Estimated total duration in seconds"
      type: "`$ANY`"
    }
    {
      name: "ftp"
      req: false
      short: "Functional Threshold Power in watts"
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "max_heart_rate"
      req: false
      short: "Maximum heart rate in BPM"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: true
      short: "Name of the workout"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "planned_date"
      req: true
      short: "Date to schedule the workout on (YYYY-MM-DD)"
      type: "`$STRING`"
    }
    {
      name: "pool_length_meters"
      req: false
      short: "Pool length in meters, for swim workouts"
      type: "`$ANY`"
    }
    {
      name: "sport"
      req: true
      short: "Sport a workout template targets."
      type: "`$ANY`"
      union: {
        branches: 15
        count: 1
        depth: 0
      }
    }
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
    {
      name: "step_blocks"
      req: true
      type: "`$ARRAY`"
      union: {
        branches: 11
        count: 8
        depth: 13
      }
    }
    {
      name: "threshold_heart_rate"
      req: false
      short: "Threshold heart rate in BPM"
      type: "`$NUMBER`"
    }
    {
      name: "threshold_speed"
      req: false
      short: "Threshold speed in m/s"
      type: "`$NUMBER`"
    }
    {
      name: "workout_id"
      req: false
      short: "Terra identifier of the stored template."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "workout"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "workout_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "user_id"
                orig: "user_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /workouts/{workout_id}/plan"
            json: "{\"operationId\":\"Workouts_PlanWorkout\",\"parameters\":[{\"in\":\"path\",\"name\":\"workout_id\",\"required\":true,\"schema\":{\"format\":\"int64\",\"type\":\"integer\"}},{\"description\":\"Terra user ID of the connection to plan the workout for\",\"in\":\"query\",\"name\":\"user_id\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"ftp\":{\"description\":\"Functional Threshold Power in watts\",\"type\":\"number\"},\"max_heart_rate\":{\"description\":\"Maximum heart rate in BPM\",\"type\":\"number\"},\"planned_date\":{\"description\":\"Date to schedule the workout on (YYYY-MM-DD)\",\"format\":\"date\",\"type\":\"string\"},\"pool_length_meters\":{\"description\":\"Pool length in meters (overrides the template value)\",\"type\":\"number\"},\"threshold_heart_rate\":{\"description\":\"Threshold heart rate in BPM\",\"type\":\"number\"},\"threshold_speed\":{\"description\":\"Threshold speed in m/s\",\"type\":\"number\"}},\"required\":[\"planned_date\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"coercion_warnings\":{\"description\":\"Set when the template could not be represented exactly on the provider.\",\"type\":\"string\"},\"planned_workout_id\":{\"example\":\"2048\",\"type\":\"string\"},\"provider_workout_id\":{\"description\":\"Identifier assigned by the provider. Absent for SDK-delivered plans.\",\"type\":\"string\"},\"status\":{\"enum\":[\"success\"],\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Planned workout created and pushed (or queued for SDK delivery)\"},\"400\":{\"content\":{\"application/problem+json\":{\"example\":{\"detail\":\"invalid start_date\",\"instance\":\"/activity\",\"title\":\"bad request\",\"type\":\"about:blank\"},\"schema\":{\"description\":\"An error response, following RFC 9457 (Problem Details for HTTP APIs, which obsoletes RFC 7807). Returned with `Content-Type: application/problem+json` on every 4xx/5xx response. The HTTP status line carries the status code; it is intentionally not repeated in the body. `type`, `title` and `instance` are always present; `detail` is included when a specific explanation is available.\\n\",\"properties\":{\"detail\":{\"description\":\"A human-readable explanation specific to this occurrence of the problem.\",\"example\":\"dev-id or x-api-key headers are missing\",\"type\":\"string\"},\"instance\":{\"description\":\"The request path, including any query string, that produced this problem.\",\"example\":\"/api/v2/activity?user_id=d4aba475-f714-4663-88fe-28f18b8599b0&to_webhook=false\",\"type\":\"string\"},\"title\":{\"description\":\"A short, human-readable summary of the problem type (the lowercased HTTP status text).\",\"example\":\"unauthorized\",\"type\":\"string\"},\"type\":{\"description\":\"A URI reference identifying the problem type. Defaults to `about:blank`.\",\"example\":\"about:blank\",\"type\":\"string\"}},\"required\":[\"type\",\"title\",\"instance\"],\"type\":\"object\"}}},\"description\":\"One or more parameters is malformed. The `detail` field describes the specific problem.\"},\"401\":{\"content\":{\"application/problem+json\":{\"example\":{\"detail\":\"dev-id or x-api-key headers are missing\",\"instance\":\"/activity\",\"title\":\"unauthorized\",\"type\":\"about:blank\"},\"schema\":{\"description\":\"An error response, following RFC 9457 (Problem Details for HTTP APIs, which obsoletes RFC 7807). Returned with `Content-Type: application/problem+json` on every 4xx/5xx response. The HTTP status line carries the status code; it is intentionally not repeated in the body. `type`, `title` and `instance` are always present; `detail` is included when a specific explanation is available.\\n\",\"properties\":{\"detail\":{\"description\":\"A human-readable explanation specific to this occurrence of the problem.\",\"example\":\"dev-id or x-api-key headers are missing\",\"type\":\"string\"},\"instance\":{\"description\":\"The request path, including any query string, that produced this problem.\",\"example\":\"/api/v2/activity?user_id=d4aba475-f714-4663-88fe-28f18b8599b0&to_webhook=false\",\"type\":\"string\"},\"title\":{\"description\":\"A short, human-readable summary of the problem type (the lowercased HTTP status text).\",\"example\":\"unauthorized\",\"type\":\"string\"},\"type\":{\"description\":\"A URI reference identifying the problem type. Defaults to `about:blank`.\",\"example\":\"about:blank\",\"type\":\"string\"}},\"required\":[\"type\",\"title\",\"instance\"],\"type\":\"object\"}}},\"description\":\"Authentication credentials are missing or invalid.\"},\"403\":{\"content\":{\"application/problem+json\":{\"schema\":{\"description\":\"An error response, following RFC 9457 (Problem Details for HTTP APIs, which obsoletes RFC 7807). Returned with `Content-Type: application/problem+json` on every 4xx/5xx response. The HTTP status line carries the status code; it is intentionally not repeated in the body. `type`, `title` and `instance` are always present; `detail` is included when a specific explanation is available.\\n\",\"properties\":{\"detail\":{\"description\":\"A human-readable explanation specific to this occurrence of the problem.\",\"example\":\"dev-id or x-api-key headers are missing\",\"type\":\"string\"},\"instance\":{\"description\":\"The request path, including any query string, that produced this problem.\",\"example\":\"/api/v2/activity?user_id=d4aba475-f714-4663-88fe-28f18b8599b0&to_webhook=false\",\"type\":\"string\"},\"title\":{\"description\":\"A short, human-readable summary of the problem type (the lowercased HTTP status text).\",\"example\":\"unauthorized\",\"type\":\"string\"},\"type\":{\"description\":\"A URI reference identifying the problem type. Defaults to `about:blank`.\",\"example\":\"about:blank\",\"type\":\"string\"}},\"required\":[\"type\",\"title\",\"instance\"],\"type\":\"object\"}}},\"description\":\"The Planned Workouts add-on is not enabled for this account.\"},\"404\":{\"content\":{\"application/problem+json\":{\"example\":{\"detail\":\"user not found\",\"instance\":\"/activity\",\"title\":\"not found\",\"type\":\"about:blank\"},\"schema\":{\"description\":\"An error response, following RFC 9457 (Problem Details for HTTP APIs, which obsoletes RFC 7807). Returned with `Content-Type: application/problem+json` on every 4xx/5xx response. The HTTP status line carries the status code; it is intentionally not repeated in the body. `type`, `title` and `instance` are always present; `detail` is included when a specific explanation is available.\\n\",\"properties\":{\"detail\":{\"description\":\"A human-readable explanation specific to this occurrence of the problem.\",\"example\":\"dev-id or x-api-key headers are missing\",\"type\":\"string\"},\"instance\":{\"description\":\"The request path, including any query string, that produced this problem.\",\"example\":\"/api/v2/activity?user_id=d4aba475-f714-4663-88fe-28f18b8599b0&to_webhook=false\",\"type\":\"string\"},\"title\":{\"description\":\"A short, human-readable summary of the problem type (the lowercased HTTP status text).\",\"example\":\"unauthorized\",\"type\":\"string\"},\"type\":{\"description\":\"A URI reference identifying the problem type. Defaults to `about:blank`.\",\"example\":\"about:blank\",\"type\":\"string\"}},\"required\":[\"type\",\"title\",\"instance\"],\"type\":\"object\"}}},\"description\":\"A referenced resource does not exist on Terra's end.\"},\"424\":{\"content\":{\"application/problem+json\":{\"schema\":{\"description\":\"An error response, following RFC 9457 (Problem Details for HTTP APIs, which obsoletes RFC 7807). Returned with `Content-Type: application/problem+json` on every 4xx/5xx response. The HTTP status line carries the status code; it is intentionally not repeated in the body. `type`, `title` and `instance` are always present; `detail` is included when a specific explanation is available.\\n\",\"properties\":{\"detail\":{\"description\":\"A human-readable explanation specific to this occurrence of the problem.\",\"example\":\"dev-id or x-api-key headers are missing\",\"type\":\"string\"},\"instance\":{\"description\":\"The request path, including any query string, that produced this problem.\",\"example\":\"/api/v2/activity?user_id=d4aba475-f714-4663-88fe-28f18b8599b0&to_webhook=false\",\"type\":\"string\"},\"title\":{\"description\":\"A short, human-readable summary of the problem type (the lowercased HTTP status text).\",\"example\":\"unauthorized\",\"type\":\"string\"},\"type\":{\"description\":\"A URI reference identifying the problem type. Defaults to `about:blank`.\",\"example\":\"about:blank\",\"type\":\"string\"}},\"required\":[\"type\",\"title\",\"instance\"],\"type\":\"object\"}}},\"description\":\"The provider rejected the workout push; retry later.\"}},\"security\":[{\"ApiKeyAuth\":[],\"DevID\":[]}],\"securitySchemes\":{\"ApiKeyAuth\":{\"description\":\"Your API key for authentication\",\"in\":\"header\",\"name\":\"x-api-key\",\"type\":\"apiKey\"},\"DevID\":{\"description\":\"Your developer ID for authentication and tracking\",\"in\":\"header\",\"name\":\"dev-id\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/workouts/{workout_id}/plan"
          rename: {
            param: {
              workout_id: "id"
            }
          }
          segments: [
            {
              lit: "workouts"
            }
            {
              var: "id"
            }
            {
              lit: "plan"
            }
          ]
          select: {
            "$action": "plan"
            exist: [
              "id"
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          contract: {
            id: "POST /workouts"
            json: "{\"operationId\":\"Workouts_CreateWorkout\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"A reusable workout template, created once and planned onto user calendars\",\"properties\":{\"description\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Description of the workout\"},\"environment\":{\"anyOf\":[{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"anyOf\":[{\"const\":\"indoor\",\"type\":\"string\"},{\"const\":\"outdoor\",\"type\":\"string\"},{\"const\":\"pool\",\"type\":\"string\"}],\"description\":\"Environment a workout takes place in\"},{\"type\":\"null\"}]},\"estimated_calories\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Estimated calories burned\"},\"estimated_distance_meters\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Estimated total distance in meters\"},\"estimated_duration_seconds\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Estimated total duration in seconds\"},\"name\":{\"description\":\"Name of the workout\",\"type\":\"string\"},\"pool_length_meters\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Pool length in meters, for swim workouts\"},\"sport\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"anyOf\":[{\"const\":\"running\",\"type\":\"string\"},{\"const\":\"cycling\",\"type\":\"string\"},{\"const\":\"swimming\",\"type\":\"string\"},{\"const\":\"strength\",\"type\":\"string\"},{\"const\":\"rowing\",\"type\":\"string\"},{\"const\":\"yoga\",\"type\":\"string\"},{\"const\":\"pilates\",\"type\":\"string\"},{\"const\":\"cardio\",\"type\":\"string\"},{\"const\":\"trail_running\",\"type\":\"string\"},{\"const\":\"mountain_biking\",\"type\":\"string\"},{\"const\":\"backcountry_skiing\",\"type\":\"string\"},{\"const\":\"hiking\",\"type\":\"string\"},{\"const\":\"walking\",\"type\":\"string\"},{\"const\":\"elliptical\",\"type\":\"string\"},{\"const\":\"stair_climbing\",\"type\":\"string\"}],\"description\":\"Sport a workout template targets. Indoor/outdoor is expressed separately via environment.\"},\"step_blocks\":{\"items\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"A block of steps, repeated until its completion condition is met\",\"properties\":{\"completion_condition\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"When this block completes (e.g. repeat count via reps)\",\"properties\":{\"type\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"anyOf\":[{\"const\":\"time\",\"type\":\"string\"},{\"const\":\"distance\",\"type\":\"string\"},{\"const\":\"hr\",\"type\":\"string\"},{\"const\":\"calories\",\"type\":\"string\"},{\"const\":\"open\",\"type\":\"string\"},{\"const\":\"power\",\"type\":\"string\"},{\"const\":\"reps\",\"type\":\"string\"},{\"const\":\"hr_percentage\",\"type\":\"string\"},{\"const\":\"power_percentage\",\"type\":\"string\"},{\"const\":\"hr_less_than\",\"type\":\"string\"},{\"const\":\"hr_greater_than\",\"type\":\"string\"}],\"description\":\"How a step or block is considered complete\"},\"value\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Single value for the condition (e.g. seconds for time, meters for distance)\"},\"value_high\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Upper bound when the condition is a range\"},\"value_low\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Lower bound when the condition is a range\"}},\"required\":[\"type\"],\"type\":\"object\"},\"steps\":{\"items\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"A single step within a step block\",\"properties\":{\"completion_condition\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"When this step completes\",\"properties\":{\"type\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"anyOf\":[{\"const\":\"time\",\"type\":\"string\"},{\"const\":\"distance\",\"type\":\"string\"},{\"const\":\"hr\",\"type\":\"string\"},{\"const\":\"calories\",\"type\":\"string\"},{\"const\":\"open\",\"type\":\"string\"},{\"const\":\"power\",\"type\":\"string\"},{\"const\":\"reps\",\"type\":\"string\"},{\"const\":\"hr_percentage\",\"type\":\"string\"},{\"const\":\"power_percentage\",\"type\":\"string\"},{\"const\":\"hr_less_than\",\"type\":\"string\"},{\"const\":\"hr_greater_than\",\"type\":\"string\"}],\"description\":\"How a step or block is considered complete\"},\"value\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Single value for the condition (e.g. seconds for time, meters for distance)\"},\"value_high\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Upper bound when the condition is a range\"},\"value_low\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Lower bound when the condition is a range\"}},\"required\":[\"type\"],\"type\":\"object\"},\"controls\":{\"anyOf\":[{\"items\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"Equipment control applied during a step\",\"properties\":{\"type\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"anyOf\":[{\"const\":\"grade\",\"type\":\"string\"},{\"const\":\"resistance\",\"type\":\"string\"}],\"description\":\"Equipment control adjusted during a step (e.g. treadmill incline)\"},\"value\":{\"description\":\"Control value (e.g. 0.02 for a 2% treadmill grade)\",\"type\":\"number\"}},\"required\":[\"type\",\"value\"],\"type\":\"object\"},\"type\":\"array\"},{\"type\":\"null\"}],\"description\":\"Equipment controls applied during the step\"},\"intensity_targets\":{\"anyOf\":[{\"items\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"Target intensity range for a step (e.g. heart-rate or power zone)\",\"properties\":{\"target_type\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"anyOf\":[{\"const\":\"speed\",\"type\":\"string\"},{\"const\":\"heart_rate\",\"type\":\"string\"},{\"const\":\"open\",\"type\":\"string\"},{\"const\":\"cadence\",\"type\":\"string\"},{\"const\":\"power\",\"type\":\"string\"},{\"const\":\"swim_stroke\",\"type\":\"string\"},{\"const\":\"speed_lap\",\"type\":\"string\"},{\"const\":\"heart_rate_lap\",\"type\":\"string\"},{\"const\":\"pace\",\"type\":\"string\"},{\"const\":\"heart_rate_threshold_percentage\",\"type\":\"string\"},{\"const\":\"heart_rate_max_percentage\",\"type\":\"string\"}],\"description\":\"Quantity an intensity target constrains\"},\"value\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Single target value\"},\"value_high\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Upper bound of the target range\"},\"value_low\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}],\"description\":\"Lower bound of the target range\"}},\"required\":[\"target_type\"],\"type\":\"object\"},\"type\":\"array\"},{\"type\":\"null\"}],\"description\":\"Intensity targets to hold during the step\"},\"intensity_type\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"anyOf\":[{\"const\":\"rest\",\"type\":\"string\"},{\"const\":\"warmup\",\"type\":\"string\"},{\"const\":\"cooldown\",\"type\":\"string\"},{\"const\":\"recovery\",\"type\":\"string\"},{\"const\":\"active\",\"type\":\"string\"}],\"description\":\"Intensity classification of a workout step\"},\"notes\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"description\":\"Free-text coaching notes shown to the athlete\"},\"strength\":{\"anyOf\":[{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"Strength-exercise details for a step\",\"properties\":{\"exercise_category\":{\"anyOf\":[{\"type\":\"string\"},{\"